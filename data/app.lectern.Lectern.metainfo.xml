  <name>Lectern</name>
  <developer id="app.lectern"><name>Lectern contributors</name></developer>
  <summary>A calm audiobook player</summary>
  <description>
    <p>Lectern keeps your audiobook library organised and remembers exactly where you stopped.</p>
    <ul>
      <li>M4B, M4A, MP3, Ogg, Opus, FLAC and folders of files, with chapters</li>
      <li>Sleep timer with fade-out, +5 minutes and end-of-chapter mode</li>
      <li>Automatic cover art from iTunes, Open Library and Google Books</li>
      <li>Volume boost up to 300%, voice clarity and night mode</li>
      <li>Media keys and desktop media controls via MPRIS</li>
    </ul>
  </description>
  <launchable type="desktop-id">app.lectern.Lectern.desktop</launchable>
