# Maintainer: dork40 <213346863+dork40@users.noreply.github.com>
pkgname=lectern
pkgver=0.8.1
pkgrel=1
pkgdesc="Audiobook player with sleep timer, automatic cover art and volume boost (GTK4/libadwaita)"
arch=('any')
url="https://github.com/dork40/lectern"
license=('GPL-3.0-or-later')
depends=(
  'python'
  'python-gobject'
  'glib2'
  'graphene'
  'hicolor-icon-theme'
  'python-cairo'
  'python-mutagen'
  'python-cryptography'  # AirPlay pairing
  'gtk4'
  'libadwaita'
  'gdk-pixbuf2'
  'pango'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-plugins-ugly'
  'gst-libav'
  'swh-plugins'      # look-ahead limiter + compressor for the volume boost
  'python-pychromecast'  # casting to Chromecast / Google TV / Android TV
  'python-zeroconf'      # finding Roku TVs and cast devices on the network
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('playerctl: control playback from the command line'
            'owntone-server: AirPlay TVs and speakers, e.g. Roku TVs (AUR)'
            'avahi: needed by OwnTone to find AirPlay devices')
source=("$pkgname-$pkgver.tar.gz::https://github.com/dork40/lectern/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e37b26283e3518c1e549d08a51930b89d93d116b5a93f78d0ee81809b1766e48')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m pytest -q
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/io.github.dork40.Lectern.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/io.github.dork40.Lectern.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.dork40.Lectern.svg \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 data/icons/hicolor/symbolic/apps/io.github.dork40.Lectern-symbolic.svg \
    -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
